# Copy this to .env and fill in your values. NEVER commit .env.
DATABASE_URL=postgresql://user:password@localhost:5432/btcbot

# Polymarket CLOB API credentials
# Get from: https://polymarket.com (connect wallet, generate API key)
POLY_PRIVATE_KEY=0x...          # Wallet private key (hex)
POLY_API_KEY=...                # CLOB API key
POLY_API_SECRET=...             # CLOB API secret
POLY_API_PASSPHRASE=...         # CLOB API passphrase

# Required extra live-trading acknowledgement. Keep unset until all gates pass.
I_ACCEPT_REAL_MONEY_RISK=no

# Binance (optional, for authenticated endpoints; public WS is free)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Alerting (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
